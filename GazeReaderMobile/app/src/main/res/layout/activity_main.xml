<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070a12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- APP HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GazeReader"
                android:textColor="#6366f1"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFirebaseSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud Synced"
                android:textColor="#10b981"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@android:drawable/dialog_holo_dark_frame" />
        </LinearLayout>

        <!-- LIVE SESSION STATUS BANNER -->
        <LinearLayout
            android:id="@+id/cardSessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSessionPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANDBY"
                    android:textColor="#f8fafc"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSessionTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting for Pomodoro session..."
                    android:textColor="#94a3b8"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStopAlarm"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Stop Alarm"
                android:textColor="#ffffff"
                android:backgroundTint="#ef4444"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- DASHBOARD TAB SWITCHER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:padding="3dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnTabDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Day"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#6366f1"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTabWeek"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Week"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:backgroundTint="#121829"
                android:padding="0dp" />

            <Button
                android:id="@+id/btnTabMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Month"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:backgroundTint="#121829"
                android:padding="0dp" />
        </LinearLayout>

        <!-- DAY VIEW: HERO 9-HOUR TARGET RING -->
        <com.gazereader.sensor.MobileFocusCircleView
            android:id="@+id/focusCircleView"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- QUEST NOTICE BANNER -->
        <TextView
            android:id="@+id/tvQuestNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quest status: Focus for 9h 0m more today to reach your 9h target!"
            android:textColor="#6366f1"
            android:textSize="13sp"
            android:padding="12dp"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- WEEK / MONTH VIEW: STACKED BAR CHART -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <!-- METRIC CARDS GRID (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- ROW 1: FOCUSED & DISTRACTED -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- FOCUSED -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:gravity="center"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:id="@+id/tvActiveMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0m"
                        android:textColor="#6366f1"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focused"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- DISTRACTED -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:gravity="center"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:id="@+id/tvDistractedMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0m"
                        android:textColor="#f43f5e"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distracted"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ROW 2: EFFICIENCY & FOCUS DEBT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- EFFICIENCY -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:gravity="center"
                    android:layout_marginEnd="5dp">

                    <TextView
                        android:id="@+id/tvEfficiency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#10b981"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Efficiency"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- FOCUS DEBT -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:gravity="center"
                    android:layout_marginStart="5dp">

                    <TextView
                        android:id="@+id/tvFocusDebt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0m"
                        android:textColor="#10b981"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Focus Debt"
                        android:textColor="#64748b"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- SENSOR SETTINGS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR SETTINGS &amp; CONNECTION"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laptop IP Address (Local Pings)"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etIp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="192.168.1.100"
                android:textColorHint="#475569"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laptop Port"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@android:drawable/editbox_background_normal"
                android:hint="5001"
                android:textColorHint="#475569"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Motion Threshold (Sensitivity)"
                android:textColor="#64748b"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <SeekBar
                android:id="@+id/sbSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="20"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSensVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0 m/s²"
                android:textColor="#cbd5e1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Start Tracking"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#6366f1" />

            <Button
                android:id="@+id/btnPinWidget"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Pin Widget to Home Screen"
                android:textColor="#cbd5e1"
                android:textSize="12sp"
                android:backgroundTint="#1e293b"
                android:layout_marginTop="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
